# Large raw datasets (PrimeKG and similar). Never commit these.
data/raw/

# Python virtual environments
.venv/
venv/
env/

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Local secrets and environment settings
.env
.env.*
!.env.example
!**/.env.example

# Editors and OS files
.idea/
.vscode/
.DS_Store

# Claude Code session state -- never committed
.claude/

