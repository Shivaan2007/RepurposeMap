{
  "components": {
    "schemas": {
      "CandidateDrug": {
        "description": "One ranked candidate drug for a ``DiseaseQuery``.",
        "properties": {
          "drug_id": {
            "title": "Drug Id",
            "type": "string"
          },
          "drug_name": {
            "title": "Drug Name",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceSummary"
            },
            "title": "Evidence",
            "type": "array"
          },
          "explanation_paths": {
            "items": {
              "$ref": "#/components/schemas/ExplanationPath"
            },
            "title": "Explanation Paths",
            "type": "array"
          },
          "safety_flags": {
            "items": {
              "$ref": "#/components/schemas/SafetyFlag"
            },
            "title": "Safety Flags",
            "type": "array"
          },
          "scores": {
            "items": {
              "$ref": "#/components/schemas/CandidateScore"
            },
            "title": "Scores",
            "type": "array"
          }
        },
        "required": [
          "drug_id",
          "drug_name"
        ],
        "title": "CandidateDrug",
        "type": "object"
      },
      "CandidateScore": {
        "description": "One scoring method's verdict on a candidate -- a disease-based\nevaluation may report several (path quality, popularity, a future\nTransE score), never collapsed into one undifferentiated number.",
        "properties": {
          "method": {
            "description": "e.g. 'path_quality', 'popularity', 'transe'",
            "title": "Method",
            "type": "string"
          },
          "rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rank"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "value",
          "method"
        ],
        "title": "CandidateScore",
        "type": "object"
      },
      "ClinicalTrialEvidence": {
        "properties": {
          "nct_id": {
            "title": "Nct Id",
            "type": "string"
          },
          "phase": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phase"
          },
          "retrieved_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieved At"
          },
          "source": {
            "$ref": "#/components/schemas/EvidenceSource",
            "default": "clinical_trials"
          },
          "source_id": {
            "description": "the source's own identifier, e.g. a PMID or NCT number -- never fabricated",
            "title": "Source Id",
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "strength": {
            "$ref": "#/components/schemas/EvidenceStrength",
            "default": "unknown"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "source_id",
          "title",
          "nct_id"
        ],
        "title": "ClinicalTrialEvidence",
        "type": "object"
      },
      "DiseaseBiologyModule": {
        "description": "What Open Targets reports for one disease: its own description,\nplus the targets most strongly associated with it, ranked by genetic\nevidence. ``total_associated_targets`` is Open Targets' total match\ncount, independent of how many are returned in ``targets``.",
        "properties": {
          "disease_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disease Description"
          },
          "disease_id": {
            "title": "Disease Id",
            "type": "string"
          },
          "disease_name": {
            "title": "Disease Name",
            "type": "string"
          },
          "retrieved_at": {
            "title": "Retrieved At",
            "type": "string"
          },
          "targets": {
            "items": {
              "$ref": "#/components/schemas/TargetAssociation"
            },
            "title": "Targets",
            "type": "array"
          },
          "total_associated_targets": {
            "title": "Total Associated Targets",
            "type": "integer"
          }
        },
        "required": [
          "disease_id",
          "disease_name",
          "total_associated_targets",
          "retrieved_at"
        ],
        "title": "DiseaseBiologyModule",
        "type": "object"
      },
      "DiseaseBiologyQuery": {
        "description": "A request to look up the disease-biology module for one disease.\nExactly one of ``disease_name``/``disease_id`` should be given --\n``disease_name`` is resolved to an Open Targets ID first (see\n``DiseaseBiologyResponse.resolved_from``); ``disease_id`` (an EFO or\nMONDO ID) skips that resolution step.",
        "properties": {
          "disease_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disease Id"
          },
          "disease_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disease Name"
          },
          "max_targets": {
            "default": 10,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Max Targets",
            "type": "integer"
          }
        },
        "title": "DiseaseBiologyQuery",
        "type": "object"
      },
      "DiseaseBiologyResponse": {
        "description": "What ``POST /api/v1/disease-biology`` returns. ``resolved_from`` is\nset only when ``disease_name`` was given and had to be resolved to an\nOpen Targets ID first -- it lists the top candidate matches Open\nTargets' own search returned, so a caller can see what else the name\ncould have meant, not just the one picked.",
        "properties": {
          "disclaimer": {
            "default": "Research evidence integration from Open Targets. Association with a gene is not a causal claim.",
            "title": "Disclaimer",
            "type": "string"
          },
          "module": {
            "$ref": "#/components/schemas/DiseaseBiologyModule"
          },
          "resolved_from": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/DiseaseMatch"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved From"
          }
        },
        "required": [
          "module"
        ],
        "title": "DiseaseBiologyResponse",
        "type": "object"
      },
      "DiseaseMatch": {
        "description": "One candidate disease returned when resolving a free-text name to\nan Open Targets disease ID (EFO or MONDO).",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "search_score": {
            "description": "Open Targets' own search relevance score, not a biological score",
            "title": "Search Score",
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "search_score"
        ],
        "title": "DiseaseMatch",
        "type": "object"
      },
      "DiseaseQuery": {
        "description": "A request to rank candidate drugs for one disease. Exactly one of\n``disease_name``/``disease_id`` should be given -- the same\nname-or-canonical-ID convention already used by the CLI's\n``rank-drugs`` command.",
        "properties": {
          "disease_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disease Id"
          },
          "disease_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disease Name"
          },
          "top_k": {
            "default": 10,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Top K",
            "type": "integer"
          }
        },
        "title": "DiseaseQuery",
        "type": "object"
      },
      "EvidenceBundle": {
        "description": "All evidence gathered so far for one candidate drug/disease pair.\nEvery list defaults empty -- an empty bundle means \"no lookups have\nbeen run yet\", never \"no evidence exists\".",
        "properties": {
          "clinical_trials": {
            "items": {
              "$ref": "#/components/schemas/ClinicalTrialEvidence"
            },
            "title": "Clinical Trials",
            "type": "array"
          },
          "generated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generated At"
          },
          "pubmed": {
            "items": {
              "$ref": "#/components/schemas/PubMedEvidence"
            },
            "title": "Pubmed",
            "type": "array"
          },
          "safety": {
            "items": {
              "$ref": "#/components/schemas/SafetyEvidence"
            },
            "title": "Safety",
            "type": "array"
          }
        },
        "title": "EvidenceBundle",
        "type": "object"
      },
      "EvidenceLookupResponse": {
        "description": "What ``POST /api/v1/evidence`` returns: one live, synchronous lookup\nacross PubMed, ClinicalTrials.gov, openFDA and DailyMed (see that\nrouter's docstring for why this is synchronous for now). ``bundle`` is\nthe same ``EvidenceBundle`` the evidence domain already defines --\npresence of a record here is not a claim of efficacy or safety.",
        "properties": {
          "bundle": {
            "$ref": "#/components/schemas/EvidenceBundle"
          },
          "disclaimer": {
            "default": "Research evidence lookup. Presence of a record is not proof of efficacy or safety.",
            "title": "Disclaimer",
            "type": "string"
          },
          "query": {
            "$ref": "#/components/schemas/EvidenceQuery"
          },
          "source_status": {
            "items": {
              "$ref": "#/components/schemas/SourceLookupStatus"
            },
            "title": "Source Status",
            "type": "array"
          }
        },
        "required": [
          "query",
          "bundle",
          "source_status"
        ],
        "title": "EvidenceLookupResponse",
        "type": "object"
      },
      "EvidenceQuery": {
        "description": "A request to look up real external evidence for one drug/disease pair.",
        "properties": {
          "disease_name": {
            "title": "Disease Name",
            "type": "string"
          },
          "drug_name": {
            "title": "Drug Name",
            "type": "string"
          },
          "max_results": {
            "default": 5,
            "description": "per source, not a total",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Results",
            "type": "integer"
          }
        },
        "required": [
          "drug_name",
          "disease_name"
        ],
        "title": "EvidenceQuery",
        "type": "object"
      },
      "EvidenceSource": {
        "description": "Where a piece of evidence would come from. Matches the sources\nnamed in the project README's \"Planned\" section.",
        "enum": [
          "pubmed",
          "clinical_trials",
          "dailymed",
          "openfda"
        ],
        "title": "EvidenceSource",
        "type": "string"
      },
      "EvidenceStrength": {
        "description": "A coarse, non-clinical categorization of evidence type -- never a\nclaim about whether the evidence shows efficacy.",
        "enum": [
          "unknown",
          "case_report",
          "observational",
          "controlled_trial",
          "systematic_review"
        ],
        "title": "EvidenceStrength",
        "type": "string"
      },
      "EvidenceSummary": {
        "description": "One piece of graph evidence linking a candidate drug toward a\ndisease -- a relation type and the node types it connects, not a path\nin full (see ``ExplanationPath`` for that).",
        "properties": {
          "display_relation": {
            "title": "Display Relation",
            "type": "string"
          },
          "relation": {
            "title": "Relation",
            "type": "string"
          },
          "source_node_type": {
            "title": "Source Node Type",
            "type": "string"
          },
          "target_node_type": {
            "title": "Target Node Type",
            "type": "string"
          }
        },
        "required": [
          "relation",
          "display_relation",
          "source_node_type",
          "target_node_type"
        ],
        "title": "EvidenceSummary",
        "type": "object"
      },
      "ExplanationPath": {
        "description": "A full mechanistic path from drug to disease, as the CLI's\n``explain-paths``/``rank-drugs`` commands already compute -- a\nhypothesis to review, not evidence of efficacy.",
        "properties": {
          "path_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path Score"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/ExplanationStep"
            },
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "steps"
        ],
        "title": "ExplanationPath",
        "type": "object"
      },
      "ExplanationStep": {
        "description": "One hop of an explanation path, mirroring\n``repurposemap.scoring.path_quality``'s own path representation.",
        "properties": {
          "relation": {
            "title": "Relation",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "source_name": {
            "title": "Source Name",
            "type": "string"
          },
          "target_id": {
            "title": "Target Id",
            "type": "string"
          },
          "target_name": {
            "title": "Target Name",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "source_name",
          "relation",
          "target_id",
          "target_name"
        ],
        "title": "ExplanationStep",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "What ``GET /health`` returns. Deliberately static -- no graph load,\nno model check, just \"is the process up and which API version is this\".",
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service",
          "status",
          "api_version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ModelProvenanceInfo": {
        "description": "What the experiment/model provenance layer\n(``repurposemap.provenance``) can safely report about model status --\nread from approved ``ml/experiments/*.json`` files only, never a\ncheckpoint tensor, never a locked-test label.",
        "properties": {
          "eligibility_reason": {
            "description": "human-readable reason behind inference_eligible",
            "title": "Eligibility Reason",
            "type": "string"
          },
          "inference_eligible": {
            "description": "whether an eligible final-training experiment record exists AND a checkpoint is explicitly configured",
            "title": "Inference Eligible",
            "type": "boolean"
          },
          "most_recent_completed_stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "stage name of the most recently generated valid experiment record",
            "title": "Most Recent Completed Stage"
          }
        },
        "required": [
          "inference_eligible",
          "eligibility_reason"
        ],
        "title": "ModelProvenanceInfo",
        "type": "object"
      },
      "ModelStatus": {
        "description": "Whether a real ranking model is configured. ``available=False`` is\nthe honest default until a specific, eligible model is explicitly\nsupplied -- never guessed, never silently assumed.",
        "properties": {
          "available": {
            "title": "Available",
            "type": "boolean"
          },
          "model_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "e.g. 'path-quality', 'transe' -- None until a model is configured",
            "title": "Model Type"
          },
          "ready_for_inference": {
            "title": "Ready For Inference",
            "type": "boolean"
          }
        },
        "required": [
          "available",
          "ready_for_inference"
        ],
        "title": "ModelStatus",
        "type": "object"
      },
      "Pathway": {
        "description": "One Reactome pathway a target participates in.",
        "properties": {
          "pathway": {
            "title": "Pathway",
            "type": "string"
          },
          "pathway_id": {
            "title": "Pathway Id",
            "type": "string"
          },
          "top_level_term": {
            "title": "Top Level Term",
            "type": "string"
          }
        },
        "required": [
          "pathway_id",
          "pathway",
          "top_level_term"
        ],
        "title": "Pathway",
        "type": "object"
      },
      "Provenance": {
        "description": "Dataset/source provenance -- only fields knowable without touching\nthe raw file (see ``repurposemap.adapters.primekg.PrimeKGFingerprint``,\nwhose ``sha256``/``size_bytes`` require reading the file and are\ndeliberately NOT surfaced here).",
        "properties": {
          "retrieved_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieved Date"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "source"
        ],
        "title": "Provenance",
        "type": "object"
      },
      "PubMedEvidence": {
        "properties": {
          "journal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Journal"
          },
          "pmid": {
            "title": "Pmid",
            "type": "string"
          },
          "publication_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Publication Date"
          },
          "publication_types": {
            "description": "PubMed's own publication-type labels (e.g. 'Clinical Trial'), copied as reported; not interpreted",
            "items": {
              "type": "string"
            },
            "title": "Publication Types",
            "type": "array"
          },
          "retrieved_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieved At"
          },
          "source": {
            "$ref": "#/components/schemas/EvidenceSource",
            "default": "pubmed"
          },
          "source_id": {
            "description": "the source's own identifier, e.g. a PMID or NCT number -- never fabricated",
            "title": "Source Id",
            "type": "string"
          },
          "strength": {
            "$ref": "#/components/schemas/EvidenceStrength",
            "default": "unknown"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "source_id",
          "title",
          "pmid"
        ],
        "title": "PubMedEvidence",
        "type": "object"
      },
      "RankingResponse": {
        "description": "The future candidate-ranking response shape. ``model_status`` must\nbe ``\"not_available\"`` -- never silently substituted with a mock or\nrandom ranking -- until a real, eligible model is explicitly wired in.",
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/CandidateDrug"
            },
            "title": "Candidates",
            "type": "array"
          },
          "disclaimer": {
            "default": "Research hypothesis ranking. Not a treatment recommendation.",
            "title": "Disclaimer",
            "type": "string"
          },
          "disease_query": {
            "$ref": "#/components/schemas/DiseaseQuery"
          },
          "model_status": {
            "enum": [
              "not_available",
              "ready"
            ],
            "title": "Model Status",
            "type": "string"
          },
          "provenance": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Provenance"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "disease_query",
          "model_status"
        ],
        "title": "RankingResponse",
        "type": "object"
      },
      "SafetyEvidence": {
        "description": "One raw safety signal from DailyMed/openFDA, before it is\ndistilled into an API-facing ``repurposemap.api.schemas.SafetyFlag``.\nNever a dosing recommendation or clinical judgment -- a pointer to a\nreal external record only.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "retrieved_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieved At"
          },
          "source": {
            "$ref": "#/components/schemas/EvidenceSource"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "source",
          "source_id",
          "description"
        ],
        "title": "SafetyEvidence",
        "type": "object"
      },
      "SafetyFlag": {
        "description": "A caution attached to a candidate -- e.g. a known contraindication\nor interaction. Structural placeholder: no safety-data source is wired\nup yet, so this is never populated with invented content.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "caution",
              "exclude"
            ],
            "title": "Severity",
            "type": "string"
          }
        },
        "required": [
          "code",
          "severity",
          "description"
        ],
        "title": "SafetyFlag",
        "type": "object"
      },
      "SourceLookupStatus": {
        "description": "Whether one of the four evidence/safety sources answered this\nrequest. A source that failed is reported here with its error, never\nsilently folded into an empty-but-successful result -- see\n``repurposemap.evidence``'s own \"never swallowed into an empty result\"\nrule, which this endpoint preserves rather than hides from the caller.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "set only when succeeded is False",
